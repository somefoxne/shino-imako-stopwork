# Danbooru Credentials
DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_USERNAME=your_username_here
DANBOORU_API_KEY=your_api_key_here

# An toàn: DRY_RUN=True sẽ chỉ mô phỏng kiểm tra và in ra màn hình các tag sẽ thêm, KHÔNG ghi lên Danbooru
# Đổi thành False khi bạn đã kiểm tra kỹ và muốn bot thực sự cập nhật tag lên Danbooru.
DRY_RUN=True

# Thời gian nghỉ giữa các request (giây) để tuân thủ Rate Limit của Danbooru (~1s)
REQUEST_DELAY=1.0

# Lý do sửa tag hiển thị trong lịch sử bài viết của Danbooru
EDIT_REASON=[Bot] Auto tag update based on rules

# Cấu hình Discord (dùng cho Noti:discord và Noti:ask)
# Để dùng Noti:ask (hỏi duyệt bằng nút bấm Discord), cần tạo Discord Bot và cấp Token + Channel ID:
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# (Tùy chọn) Webhook URL nếu bạn chỉ dùng Noti:discord để gửi log thông báo
DISCORD_WEBHOOK_URL=

# Thời gian chờ duyệt tối đa cho mỗi post (giây), hết thời gian sẽ tự động bỏ qua
ASK_TIMEOUT_SECONDS=120
