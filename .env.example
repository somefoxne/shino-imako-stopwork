# ==============================================================================
# DANBOORU CREDENTIALS (MÔI TRƯỜNG CHÍNH THỨC)
# ==============================================================================
DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_USERNAME=your_username_here
DANBOORU_API_KEY=your_api_key_here

# ==============================================================================
# CHẾ ĐỘ TEST MODE (TESTBOORU - https://testbooru.donmai.us)
# ==============================================================================
# Bật TEST_MODE=True để chuyển toàn bộ bot sang chạy trên Testbooru.
# Đổi thành False để chạy trên Danbooru thật.
TEST_MODE=False

TESTBOORU_URL=https://testbooru.donmai.us
# Nếu để trống USERNAME / API_KEY của Testbooru, bot sẽ tự lấy tài khoản Danbooru ở trên
TESTBOORU_USERNAME=
TESTBOORU_API_KEY=

# ==============================================================================
# THIẾT LẬP CHẠY AN TOÀN
# ==============================================================================
# DRY_RUN=True: Chỉ mô phỏng kiểm tra và in ra màn hình, KHÔNG ghi đè lên server
# Đổi thành False khi bạn muốn bot thực sự cập nhật tag lên Danbooru/Testbooru.
DRY_RUN=True

# Thời gian nghỉ giữa các request (giây) để tuân thủ Rate Limit (~1s)
REQUEST_DELAY=1.0

# Lý do sửa tag hiển thị trong lịch sử bài viết
EDIT_REASON=[Bot] Auto tag update based on rules

# ==============================================================================
# CẤU HÌNH KIỂM SOÁT SỬA LẠI (ANTI EDIT-WAR / RE-ADD POLICY)
# ==============================================================================
# - "never"       : Không bao giờ add lại tag đó nếu đã từng bị xóa (an toàn nhất)
# - "after_edits" : Chỉ add lại nếu sau khi bị xóa đã có ít nhất N lượt sửa của người khác
RE_ADD_POLICY=never
MIN_EDITS_BEFORE_READD=5

# ==============================================================================
# CẤU HÌNH DISCORD
# ==============================================================================
# - Noti:discord : CHỈ gửi log thông báo sau khi hoàn tất
# - Noti:ask     : CHỈ gửi câu hỏi duyệt bằng nút bấm (Đồng ý / Bỏ qua)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_WEBHOOK_URL=
