# Danbooru Credentials
DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_USERNAME=your_username_here
DANBOORU_API_KEY=your_api_key_here

# An toàn: DRY_RUN=True sẽ chỉ mô phỏng kiểm tra và in ra màn hình các tag sẽ thêm, KHÔNG ghi lên Danbooru
# Đổi thành False khi bạn đã kiểm tra kỹ và muốn bot thực sự cập nhật tag lên Danbooru.
DRY_RUN=True

# Thời gian nghỉ giữa các request (giây) để tuân thủ Rate Limit của Danbooru (~1s)
REQUEST_DELAY=1.0

# Lý do sửa tag hiển thị trong lịch sử bài viết của Danbooru
EDIT_REASON=[Bot] Auto tag update based on rules

# ==============================================================================
# CẤU HÌNH KIỂM SOÁT SỬA LẠI (ANTI EDIT-WAR / RE-ADD POLICY)
# ==============================================================================
# Chính sách khi tag đã từng được bot thêm nhưng sau đó bị người khác xóa:
#   - "never"       : Không bao giờ add lại tag đó cho post đó nữa (mặc định an toàn nhất)
#   - "after_edits" : Chỉ add lại nếu sau khi bị xóa đã có ít nhất N lượt chỉnh sửa từ người khác
RE_ADD_POLICY=never

# Số lượt chỉnh sửa tối thiểu của người khác trước khi bot được phép add lại (khi RE_ADD_POLICY=after_edits)
MIN_EDITS_BEFORE_READD=5

# ==============================================================================
# CẤU HÌNH DISCORD (Dùng cho Noti:discord và Noti:ask)
# ==============================================================================
# - Noti:discord : Chỉ gửi log thông báo kết quả cập nhật vào Discord
# - Noti:ask     : Gửi embed có nút bấm Đồng ý / Bỏ qua để hỏi duyệt trước khi thêm
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# (Tùy chọn) Webhook URL nếu bạn chỉ dùng Noti:discord để nhận log
DISCORD_WEBHOOK_URL=

# Thời gian chờ duyệt tối đa cho Noti:ask (giây), hết giờ sẽ tự động bỏ qua
ASK_TIMEOUT_SECONDS=120
